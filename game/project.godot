; Godot 项目配置文件
;
; 本项目由 AI 辅助开发，配置约定见仓库根目录的 AGENTS.md。
; 注意：本文件的 [input] 段是输入映射的「权威来源」，同时 GameConfig 里有一份
;      运行时兜底注册（防止输入映射被误删导致游戏直接报错）。

config_version=5

[application]

config/name="武侠肉鸽 · 可验证骨架"
config/description="横版武侠肉鸽（Dead Cells 类）的最小可验证骨架。含状态机、帧数据、顿帧、震屏、调试台、种子化重放与单元测试。"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameConfig="*res://scripts/core/game_config.gd"
EventBus="*res://scripts/core/event_bus.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.105, 0.098, 0.129, 1)

