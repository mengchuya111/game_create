# ============================================================
#  Godot 4
# ============================================================
# Godot 自动生成的导入缓存，绝对不能入库
game/.godot/
# 导出产物
game/build/
game/export/
game/*.pck
game/*.zip

# ============================================================
#  本仓库的本地工具链（Godot 编辑器本体等，不入库）
# ============================================================
.tooling/
.acl_report/

# 工具私有工作目录（AI 助手的会话记忆、临时状态）。
# 里面的开发日志对团队有参考价值，但它是工具私有格式、且会不断变动，
# 所以默认不入库。要保留历史请把内容整理进 docs/ 或提交信息里。
.workbuddy/

# ============================================================
#  操作系统
# ============================================================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ============================================================
#  编辑器 / IDE
# ============================================================
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~

# ============================================================
#  其他
# ============================================================
*.log
*.tmp
__pycache__/
node_modules/

# 演示录制产物
shots/

# ============================================================
#  监管打卡 App（tools/checkin）
# ============================================================
# 打卡记录是私人数据，不该推给队友。
# 脚本和页面要入库（队友也能用），只有运行时产生的数据文件排除。
tools/checkin/data.json
tools/checkin/data.json.tmp
tools/checkin/data.json.broken-*
