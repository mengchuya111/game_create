# 统一换行符，避免 Windows / macOS 协作者之间产生无意义的整文件 diff
* text=auto eol=lf

# ---------- 文本文件：强制 LF ----------
*.gd        text eol=lf
*.tscn      text eol=lf
*.tres      text eol=lf
*.godot     text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.ps1       text eol=lf
*.sh        text eol=lf
*.cfg       text eol=lf
*.import    text eol=lf

# ---------- 二进制资源：禁止换行符转换、禁止 diff ----------
*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.gif       binary
*.svg       text eol=lf
*.ogg       binary
*.wav       binary
*.mp3       binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary

